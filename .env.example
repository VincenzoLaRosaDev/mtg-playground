# Environments: local → Neon branch `dev` + Google local client
#               Vercel Preview (git `dev`) → Neon `Staging` + Google staging client
#               Vercel Production (git `main`) → Neon `production` + Google prod client
# See docs/ARCHITECTURE.md § Environments.

# Pooled connection — used by the app at runtime (match this env’s Neon branch)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Direct connection — Prisma migrations only (same Neon branch as DATABASE_URL)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Optional: canonical site URL for SEO (metadata, sitemap, robots)
# NEXT_PUBLIC_SITE_URL="https://mtgplayground.example.com"

# Auth.js (Phase 2.1) — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Canonical Auth.js URL (optional).
# Leave unset for normal localhost. For phone OAuth, Google rejects private IPs
# (192.168.x.x) as redirect URIs — use a public tunnel (e.g. cloudflared) and set
# AUTH_URL to that https://… origin; register the same /api/auth/callback/{provider}.
# AUTH_URL="https://your-tunnel.example"

# Closed-beta allowlist (comma-separated). Empty/unset = sign-in open to anyone.
# Entries: full address (a@b.com) or whole domain (@b.com).
# NOTE: Google's "Testing" publishing status does NOT restrict apps that request
# only openid/email/profile — this variable is the real access gate.
# AUTH_ALLOWED_EMAILS="you@gmail.com,tester@gmail.com"

# OAuth (optional independently — omit a pair to disable that provider)
# Use the Google client for this environment (local / staging / prod) — separate
# OAuth clients with matching authorized redirect URIs.
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_DISCORD_ID=""
# AUTH_DISCORD_SECRET=""

# Magic link via Resend (optional — without AUTH_RESEND_KEY, email sign-in is disabled)
# AUTH_RESEND_KEY=""
# AUTH_RESEND_FROM="MTGPlayground <noreply@yourdomain.com>"

# GitHub Actions sync jobs use repository secret DATABASE_URL (Neon pooled).
# There is no app /api/sync endpoint — workflows run npm scripts directly.
